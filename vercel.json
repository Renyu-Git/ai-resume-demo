{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ai-ux-diagnostic",
      "destination": "https://ai-ux-diagnostic-demo.vercel.app/",
      "permanent": true
    },
    {
      "source": "/ai-ux-diagnostic/",
      "destination": "https://ai-ux-diagnostic-demo.vercel.app/",
      "permanent": true
    }
  ]
}
